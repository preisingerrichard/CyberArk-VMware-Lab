# ── CyberArk installer files ────────────────────────────────────
# Exclude all files inside Installers/ but keep the folder structure
# visible on GitHub via .gitkeep placeholders
Installers/**/*
!Installers/**/.gitkeep

# ── Windows Server ISO ───────────────────────────────────────────
ISO/

# ── Claude Code project files ────────────────────────────────────
.claude/
# Claude context lives in .claude/ (CLAUDE.md + rules/) and is private.
# Guard: never commit a copy created in the root either.
CLAUDE.md
CLAUDE.local.md

# ── Runtime state (generated during deployment) ──────────────────
Config/DeployedVMs.xml

# ── SSH keys (generated per-VM, machine-specific) ────────────────
Config/pta_lab_key
Config/pta_lab_key.pub
Config/psmp_lab_key
Config/psmp_lab_key.pub
Config/conjur_lab_key
Config/conjur_lab_key.pub

# ── Conjur native master keys (decrypt the whole cluster - never commit) ──
Config/ConjurSecrets/

# ── Windows null device (ssh.exe UserKnownHostsFile=NUL artifact) ─
NUL

# ── Deployment logs ──────────────────────────────────────────────
Logs/

# ── Temp files ───────────────────────────────────────────────────
*.tmp

# ── Python bytecode cache (Helpers\PTAInstallerWizard.py) ───────
__pycache__/
*.pyc

# ── Private client-engagement notes (never for GitHub) ────────────
CLIENT-*.md

# ── Playwright E2E demo for the blog article (never for GitHub) ───
# Local-only test project run against this lab's PVWA; the article
# is the published artefact, not this folder.
PlaywrightDemo/

# ── App-specific Conjur policy test content (never for GitHub) ────
# Repo's own contribution stops at loading the root policy
# (Scripts\41-LoadConjurRootPolicy.ps1). Real app/workload policy
# (apps/gitlab, apps/k8s, etc.) is client-representative test content,
# not a generic lab feature.
AppPolicyTesting/
